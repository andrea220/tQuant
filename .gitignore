# Ignora le cartelle di build e distribuzione
build/
dist/
*.egg-info/

# Ignora i file bytecode Python
__pycache__/
*.py[cod]

# Ignora i file di configurazione del sistema operativo
.DS_Store

# Ignora i notebook Jupyter e i file Excel
*.ipynb
*.xlsx
# study/: i notebook vanno versionati, gli artefatti LaTeX no
!study/**/*.ipynb
!tqstudio/testviews/*.ipynb
study/docs/build/
.ipynb_checkpoints/

# Libri e risorse di riferimento (locali, non versionati)
resources/
